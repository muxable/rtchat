{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "predeploy": "npm --prefix \"$RESOURCE_DIR\" ci && npm --prefix \"$RESOURCE_DIR\" run build"
  },
  "hosting": {
    "public": "public",
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://rtirl.com/privacy-policy/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/auth/**",
        "function": "auth"
      },
      {
        "source": "/api/send",
        "function": "send"
      },
      {
        "source": "/api/subscribe",
        "function": "subscribe"
      },
      {
        "source": "/api/metadata",
        "function": "metadata"
      },
      {
        "source": "/api/kick/webhook",
        "function": "kickWebhook"
      },
      {
        "source": "/embed",
        "function": "embedRedirect"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
