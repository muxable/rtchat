i]=a0[((u32(13+i32(((i/25u)%1u))*1))*25u+(((i/25u)%1u))*25u+(((i/1u)%25u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read> a3:array<f32>;\n@group(0) @binding(4) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*128u;if(i>=25u){return;}\ny[i]=a0[((u32(14+i32(((i/25u)%1u))*1))*25u+(((i/25u)%1u))*25u+(((i/1u)%25u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*6400u;if(i>=6400u){return;}\ny[i]=a0[i]+a1[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[i]+a1[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> activations:array<f32,256>;\nvar<workgroup> weights:array<f32,256>;\n@compute @workgroup_size(8,8) fn main(\n  @builtin(workgroup_id) group:vec3u, @builtin(local_invocation_id) lane:vec3u){\n let x0=group.x*32u+lane.x; let f0=group.y*32u+lane.y;\n var sums:array<vec4f,4>;\n for(var r=0u;r<4u;r++){let f=f0+8u*r;if(f<1024u){sums[r]=vec4f(a2[f]);}}\n for(var k=0u;k<3u;k+=1u){\n  for(var base=0u;base<512u;base+=8u){\n   for(var j=0u;j<4u;j++){\n    let t=(x0+j*8u)*1u+group.z;let p=i32(t*1u+k*1u)-2;let src=lane.y*32u+lane.x+8u*j;\n    activations[src]=0.0;\n    if(p>=0 && u32(p)<25u){activations[src]=a0[(base+lane.y)*25u+u32(p)];}\n    let f=f0+j*8u;let c=base+lane.x;let ic=c;\n    let wt=(lane.y+8u*j)*8u+lane.x;weights[wt]=0.0;\n    if(f<1024u){weights[wt]=a1[(f*512u+c)*3u+k];}\n   }workgroupBarrier();\n   for(var channel=0u;channel<8u;channel++){\n    let o=channel*32u+lane.x;\n    let v=vec4f(activations[o],activations[o+8u],activations[o+16u],activations[o+24u]);\n    for(var r=0u;r<4u;r++){sums[r]+=v*weights[(lane.y+r*8u)*8u+channel];}\n   }workgroupBarrier();\n  }\n }\n for(var r=0u;r<4u;r++){let f=f0+r*8u;if(f<1024u){\n  for(var j=0u;j<4u;j++){let t=(x0+j*8u)*1u+group.z;if(t<25u){y[f*25u+t]=sums[r][j];}}\n }}\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\ny[i]=a0[((((i/25600u)%1u))*25600u+(((i/1u)%1024u))*25u+(((i/1024u)%25u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> aa:array<f32,256>;var<workgroup> bb:array<f32,256>;\n@compute @workgroup_size(16,16) fn main(@builtin(workgroup_id) g:vec3u,@builtin(local_invocation_id) t:vec3u){\nlet row=g.y*16u+t.y;let col=g.x*16u+t.x;let lane=t.y*16u+t.x;var acc=0.0;\nfor(var s=0u;s<1024u;s+=16u){\naa[lane]=0.0;bb[lane]=0.0;\nif(row<25u && s+t.x<1024u){aa[lane]=a0[(g.z*25u+row)*1024u+s+t.x];}\nif(col<512u && s+t.y<1024u){bb[lane]=a1[(0u*1024u+s+t.y)*512u+col];}\nworkgroupBarrier();for(var j=0u;j<16u;j++){acc+=aa[t.y*16u+j]*bb[j*16u+t.x];}workgroupBarrier();\n}if(row<25u && col<512u){y[(g.z*25u+row)*512u+col]=acc;}}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[i]+a1[((((i/1u)%512u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[i]*a0[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\nvar<workgroup> scratch:array<f32,64>;\n@compute @workgroup_size(64) fn main(@builtin(workgroup_id) g:vec3u,@builtin(local_invocation_index) lane:u32){let base=g.x*512u;{var acc:f32=0.0; for(var j=lane;j<512u;j+=64u){acc=acc+a0[base+j];}\nscratch[lane]=acc;workgroupBarrier();\nfor(var s=32u;s>0u;s=s>>1u){if(lane<s){scratch[lane]=scratch[lane]+scratch[lane+s];}workgroupBarrier();}}let mean=scratch[0]/512.0;if(lane==0u){y[g.x]=mean;}}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*128u;if(i>=25u){return;}\ny[i]=a0[i]+a1[0u];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*128u;if(i>=25u){return;}\ny[i]=sqrt(a0[i]);\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*128u;if(i>=25u){return;}\ny[i]=1.0/a0[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[i]*a1[((0u)*25u+(((i/512u)%25u))*1u+(0u)*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[((((i/1u)%512u))*1u)]*a1[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> aa:array<f32,256>;var<workgroup> bb:array<f32,256>;\n@compute @workgroup_size(16,16) fn main(@builtin(workgroup_id) g:vec3u,@builtin(local_invocation_id) t:vec3u){\nlet row=g.y*16u+t.y;let col=g.x*16u+t.x;let lane=t.y*16u+t.x;var acc=0.0;\nfor(var s=0u;s<512u;s+=16u){\naa[lane]=0.0;bb[lane]=0.0;\nif(row<25u && s+t.x<512u){aa[lane]=a0[(g.z*25u+row)*512u+s+t.x];}\nif(col<1024u && s+t.y<512u){bb[lane]=a1[(0u*512u+s+t.y)*1024u+col];}\nworkgroupBarrier();for(var j=0u;j<16u;j++){acc+=aa[t.y*16u+j]*bb[j*16u+t.x];}workgroupBarrier();\n}if(row<25u && col<1024u){y[(g.z*25u+row)*1024u+col]=acc;}}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\ny[i]=a0[((((i/25600u)%1u))*25600u+(((i/64u)%25u))*1024u+(((i/1600u)%16u))*64u+(((i/1u)%64u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\ny[i]=a0[i]*a1[((0u)*1600u+(0u)*1600u+(((i/64u)%25u))*64u+(((i/1u)%64u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read> a3:array<f32>;\n@group(0) @binding(4) var<storage,read> a4:array<f32>;\n@group(0) @binding(5) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[((((i/12800u)%1u))*25600u+(((i/800u)%16u))*1600u+(((i/32u)%25u))*64u+(u32(0+i32(((i/1u)%32u))*1))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read> a3:array<f32>;\n@group(0) @binding(4) var<storage,read> a4:array<f32>;\n@group(0) @binding(5) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=a0[((((i/12800u)%1u))*25600u+(((i/800u)%16u))*1600u+(((i/32u)%25u))*64u+(u32(32+i32(((i/1u)%32u))*1))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*12800u;if(i>=12800u){return;}\ny[i]=-a0[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\nlet c=((i/1u)%64u);let outer=i/64u;if(c<32u){y[i]=a0[(outer*32u+c-0u)*1u+i%1u];return;}if(c<64u){y[i]=a1[(outer*32u+c-32u)*1u+i%1u];return;}\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\ny[i]=a0[i]+a1[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*25600u;if(i>=25600u){return;}\ny[i]=a0[((((i/25600u)%1u))*25600u+(((i/1600u)%16u))*1600u+(((i/1u)%25u))*64u+(((i/25u)%64u))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> aa:array<f32,256>;var<workgroup> bb:array<f32,256>;\n@compute @workgroup_size(16,16) fn main(@builtin(workgroup_id) g:vec3u,@builtin(local_invocation_id) t:vec3u){\nlet row=g.y*16u+t.y;let col=g.x*16u+t.x;let lane=t.y*16u+t.x;var acc=0.0;\nfor(var s=0u;s<64u;s+=16u){\naa[lane]=0.0;bb[lane]=0.0;\nif(row<25u && s+t.x<64u){aa[lane]=a0[(g.z*25u+row)*64u+s+t.x];}\nif(col<25u && s+t.y<64u){bb[lane]=a1[(g.z*64u+s+t.y)*25u+col];}\nworkgroupBarrier();for(var j=0u;j<16u;j++){acc+=aa[t.y*16u+j]*bb[j*16u+t.x];}workgroupBarrier();\n}if(row<25u && col<25u){y[(g.z*25u+row)*25u+col]=acc;}}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*10112u;if(i>=10000u){return;}\ny[i]=a0[i]*a1[0u];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write>