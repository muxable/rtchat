 activations[src]=0.0;\n    if(p>=0 && u32(p)<800u){activations[src]=a0[(base+lane.y)*800u+u32(p)];}\n    let f=f0+j*8u;let c=base+lane.x;let ic=c;\n    let wt=(lane.y+8u*j)*8u+lane.x;weights[wt]=0.0;\n    if(f<768u){weights[wt]=a1[(f*768u+c)*7u+k];}\n   }workgroupBarrier();\n   for(var channel=0u;channel<8u;channel++){\n    let o=channel*32u+lane.x;\n    let v=vec4f(activations[o],activations[o+8u],activations[o+16u],activations[o+24u]);\n    for(var r=0u;r<4u;r++){sums[r]+=v*weights[(lane.y+r*8u)*8u+channel];}\n   }workgroupBarrier();\n  }\n }\n for(var r=0u;r<4u;r++){let f=f0+r*8u;if(f<768u){\n  for(var j=0u;j<4u;j++){let t=(x0+j*8u)*1u+group.z;if(t<800u){y[f*800u+t]=sums[r][j];}}\n }}\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> activations:array<f32,256>;\nvar<workgroup> weights:array<f32,256>;\n@compute @workgroup_size(8,8) fn main(\n  @builtin(workgroup_id) group:vec3u, @builtin(local_invocation_id) lane:vec3u){\n let x0=group.x*32u+lane.x; let f0=group.y*32u+lane.y;\n var sums:array<vec4f,4>;\n for(var r=0u;r<4u;r++){let f=f0+8u*r;if(f<384u){sums[r]=vec4f(a2[f]);}}\n for(var k=(group.z+0u)%5u;k<10u;k+=5u){\n  for(var base=0u;base<768u;base+=8u){\n   for(var j=0u;j<4u;j++){\n    let t=(x0+j*8u)*5u+group.z;let p=i32(t)+0-i32(k*1u);let src=lane.y*32u+lane.x+8u*j;\n    activations[src]=0.0;\n    if(p>=0 && u32(p)/5u<800u && u32(p)%5u==0u){activations[src]=a0[(base+lane.y)*800u+u32(p)/5u];}\n    let f=f0+j*8u;let c=base+lane.x;let ic=c;\n    let wt=(lane.y+8u*j)*8u+lane.x;weights[wt]=0.0;\n    if(f<384u){weights[wt]=a1[(ic*384u+f%384u)*10u+k];}\n   }workgroupBarrier();\n   for(var channel=0u;channel<8u;channel++){\n    let o=channel*32u+lane.x;\n    let v=vec4f(activations[o],activations[o+8u],activations[o+16u],activations[o+24u]);\n    for(var r=0u;r<4u;r++){sums[r]+=v*weights[(lane.y+r*8u)*8u+channel];}\n   }workgroupBarrier();\n  }\n }\n for(var r=0u;r<4u;r++){let f=f0+r*8u;if(f<384u){\n  for(var j=0u;j<4u;j++){let t=(x0+j*8u)*5u+group.z;if(t<4005u){y[f*4005u+t]=sums[r][j];}}\n }}\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read> a3:array<f32>;\n@group(0) @binding(4) var<storage,read> a4:array<f32>;\n@group(0) @binding(5) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*1536000u;if(i>=1536000u){return;}\ny[i]=a0[((((i/1536000u)%1u))*1537920u+(((i/4000u)%384u))*4005u+(u32(0+i32(((i/1u)%4000u))*1))*1u)];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read_write> y:array<f32>;\n@compute @workgroup_size(128)\nfn main(@builtin(global_invocation_id) id:vec3u){\nlet i=id.x+id.y*1536000u;if(i>=1536000u){return;}\ny[i]=a0[i]+a1[i];\n}","@group(0) @binding(0) var<storage,read> a0:array<f32>;\n@group(0) @binding(1) var<storage,read> a1:array<f32>;\n@group(0) @binding(2) var<storage,read> a2:array<f32>;\n@group(0) @binding(3) var<storage,read_write> y:array<f32>;\n\nvar<workgroup> activations:array<f32,256>;\nvar<workgroup> weights:array<f32,256>;\n@compute @workgroup_size(8,8) fn main(\n  @builtin(workgroup_id) group:vec3u, @builtin(local_invocation_id) lane:vec3u){\n let x0=group.x*32u+lane.x; let f0=group.y*32u+lane.y;\n var sums:array<vec4f,4>;\n for(var r=0u;r<4u;r++){let f=f0+8u*r;if(f<384u){sums[r]=vec4f(a2[f]);}}\n for(var k=0u;k<7u;k+=1u){\n  for(var base=0u;base<384u;base+=8u){\n   for(var j=0u;j<4u;j++){\n    let t=(x0+j*8u)*1u+group.z;let p=i32(t*1u+k*1u)-6;let src=lane.y*32u+lane.x+8u*j;\n    activations[src]=0.0;\n    if(p>=0 && u32(p)<4000u){activations[src]=a0[(base