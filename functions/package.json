    "express-session": "^1.17.3",
    "firebase-admin": "^11.5.0",
    "firebase-functions": "^5.0.1",
    "simple-oauth2": "^4.3.0"
  },
  "devDependencies": {
    "@types/express-session": "^1.17.5",
    "@types/node": "18.11.18",
    "@types/simple-oauth2": "^4.1.1",
    "firebase-tools": "^13.8.0",
    "prettier": "^2.7.1",
    "typescript": "^4.8.2",
    "vitest": "^3.2.7"
  },
  "private": true,
