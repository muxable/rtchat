        }
      },
      {
        "xPos": 24,
        "yPos": 64,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Chat messages created/min by provider",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (provider) (rate(logging_googleapis_com:user_agent_chat_events_sum{monitored_resource=\"gce_instance\", kind=\"message\", outcome=\"created\"}[5m]))"
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
